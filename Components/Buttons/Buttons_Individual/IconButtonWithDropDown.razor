<div class="button-container" style="height:@HeightCSS">

    <button class="button-header-content" @onclick=@HandleOnclick>
        <SingleIcon Icon="@BuildData.Icon" IconColor="blue" IconSize=@BuildData.IconSize />
        <span class="button-title">@BuildData.ButtonText</span>

        <i class="icon-right" style="visibility: @CloseButtonCSS">
                <SingleIcon Icon=" bi bi-caret-up" IconColor="grey" IconSize="icon-size-small" />
            </i>
    </button>

    <div class="button-body-content">
        @BuildData.DropDownContent
       
    </div>
    
    
</div>
