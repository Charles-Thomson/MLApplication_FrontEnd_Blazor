@using MachineLearningApplication_Build_2.Components.SubHeadings;
@inject Services.InstanceAttributeStateContainer stateContainer


<SideBarMenuGroupSubPageLayout Title="@PageTitle">
    <div class="sub-page-main-content">
        <span>Review and Submit for processing</span>
        <LabelWithAttributeTextHorizontal LabelText="Instance Name" ContentText="@stateContainer.InstanceName" />

        <SubHeadingUnderlined SubHeadingText="Hyperperameters" />
        <LabelWithAttributeTextHorizontal LabelText="Generations" ContentText="@stateContainer.NumberOfGenerations" />
        <LabelWithAttributeTextHorizontal LabelText="Agents" ContentText="@stateContainer.AgentsPerGeneration" />
        <LabelWithAttributeTextHorizontal LabelText="New Generation Threshold" ContentText="@stateContainer.StartNewGenerationThreshold" />
        <LabelWithAttributeTextHorizontal LabelText="Failure Threshold" ContentText="@stateContainer.GenerationFailureThreshold" />
        <LabelWithAttributeTextHorizontal LabelText="Max Actions" ContentText="@stateContainer.EnvironmentMaxActionCount" />
        <LabelWithAttributeTextHorizontal LabelText="Creation Function" ContentText="@stateContainer.NewGenerationCreationFunction" />
        
        <SubHeadingUnderlined SubHeadingText="Neural Network" />
        <LabelWithAttributeTextHorizontal LabelText="Hidden Layer Weight Init" ContentText="@stateContainer.HiddenLayerWeightInit" />
        <LabelWithAttributeTextHorizontal LabelText="Output Layer Weight Init" ContentText="@stateContainer.OutputLayerWeightInit" />
        <LabelWithAttributeTextHorizontal LabelText="Hidden Layer Activation" ContentText="@stateContainer.HiddenLayerActivationFunction" />
        <LabelWithAttributeTextHorizontal LabelText="Output Layer Activation" ContentText="@stateContainer.OutputLayerActivationFunction" />
        
        <SubHeadingUnderlined SubHeadingText="Environment" />
        <LabelWithAttributeTextHorizontal LabelText="Dimension X" ContentText="@stateContainer.EnvironmentDimension_X" />
        <LabelWithAttributeTextHorizontal LabelText="Dimension Y" ContentText="@stateContainer.EnvironmentDimension_Y" />
        <LabelWithAttributeTextHorizontal LabelText="Start State" ContentText="@stateContainer.OutputLayerActivationFunction.ToString()" />

        


    </div>

</SideBarMenuGroupSubPageLayout>
